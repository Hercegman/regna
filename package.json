{
  "name": "regna",
  "version": "0.1.0",
  "private": true,
  "description": "Regna: Age of Kingdoms - original turn-based grand strategy with real-time battles",
  "type": "module",
  "author": "hercegman",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "diagnose": "esbuild tools/diagnose.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/diagnose.mjs && node node_modules/.cache/diagnose.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
